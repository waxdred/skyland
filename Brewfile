# skyland dependencies: brew bundle (bin/skyland-install runs it)
tap "felixkratz/formulae"
brew "swiftly"        # Swift toolchain manager, skyland builds with Swift 6.4 (.swift-version)
brew "cmake"          # mediaremote-adapter (media widget)
brew "jq"             # scripts
brew "sketchybar"     # bar (bring your own sketchybarrc, see README)
brew "borders"        # focused window border ([decoration] border-width)
cask "font-hack-nerd-font"
# matugen (wallpaper colors) is a Rust crate: cargo install matugen

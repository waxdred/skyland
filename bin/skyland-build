#!/usr/bin/env bash
# Build the app and wrap it in .build/Skyland.app so macOS can grant
# Accessibility to the bundle instead of the launching terminal.
# Signed with the skyland-codesign identity (bin/skyland-cert) when present, so
# Accessibility stays granted across rebuilds; falls back to ad-hoc, which must
# be re-granted after every rebuild. Override with SKYLAND_SIGN_IDENTITY.
# Release configuration (-O, whole module); `--debug` or SKYLAND_DEBUG=1 for a debug
# build while developing.
# usage: skyland-build [--debug]
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

cfg=release
[[ "${1:-}" == --debug || "${SKYLAND_DEBUG:-}" == 1 ]] && cfg=debug
swiftly run swift build -c $cfg --product AeroSpaceApp
swiftly run swift build -c $cfg --product aerospace
bin="$(swiftly run swift build -c $cfg --show-bin-path)"
# the CLI every script and sketchybar item calls; rm first: overwriting a signed
# binary in place gets it killed by macOS (Code Signature Invalid)
rm -f .build/aerospace
cp "$bin/aerospace" .build/aerospace
swiftc -O tools/wallpaper-picker/main.swift Sources/SkylandGlass/*.swift -o .build/skyland-wallpaper-picker # + ui-style glass
swiftc -O tools/keys-help.swift -o .build/skyland-keys
# media widget + its now playing backend (git submodule, BSD-3)
[[ -f third_party/mediaremote-adapter/CMakeLists.txt ]] || git submodule update --init third_party/mediaremote-adapter
cmake -S third_party/mediaremote-adapter -B .build/mediaremote >/dev/null
cmake --build .build/mediaremote >/dev/null
swiftc -O -enforce-exclusivity=unchecked tools/media-widget/main.swift Sources/SkylandGlass/*.swift -o .build/skyland-media
"$PWD/bin/skyland-lock" refresh # re-sign the installed lock screen if any

app=.build/Skyland.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp "$bin/AeroSpaceApp" "$app/Contents/MacOS/"
# default config read at startup (Bundle.main): a debug build else looks for it
# in the source tree it was compiled in, which a release zip does not have
mkdir -p "$app/Contents/Resources"
cp docs/config-examples/default-config.toml "$app/Contents/Resources/"
cp resources/Skyland.icns "$app/Contents/Resources/" # resources/icon/make-icns
# Bundle id must match aeroSpaceAppId (Sources/Common/appMetadata.swift)
cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.waxdred.skyland</string>
    <key>CFBundleName</key><string>Skyland</string>
    <key>CFBundleIconFile</key><string>Skyland</string>
    <key>CFBundleExecutable</key><string>AeroSpaceApp</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>LSUIElement</key><true/>
</dict>
</plist>
EOF
identity=-
security find-identity -v -p codesigning | grep -q '"skyland-codesign"' && identity=skyland-codesign
codesign --force --sign "${SKYLAND_SIGN_IDENTITY:-$identity}" --entitlements resources/AeroSpace.entitlements "$app"
echo "built $app ($cfg)"

#!/usr/bin/env bash
# Build the app and wrap it in .build/Skyland.app so macOS can grant
# Accessibility to the bundle instead of the launching terminal.
# ponytail: ad-hoc signature changes on every build, so Accessibility must be
# re-granted after each rebuild; use a self-signed cert if that gets annoying.
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

swiftly run swift build --product AeroSpaceApp
swiftly run swift build --product aerospace

app=.build/Skyland.app
rm -rf "$app"
mkdir -p "$app/Contents/MacOS"
cp .build/debug/AeroSpaceApp "$app/Contents/MacOS/"
# Bundle id must match aeroSpaceAppId of the debug build (Sources/Common/appMetadata.swift)
cat > "$app/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>bobko.aerospace.debug</string>
    <key>CFBundleName</key><string>Skyland</string>
    <key>CFBundleExecutable</key><string>AeroSpaceApp</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>LSUIElement</key><true/>
</dict>
</plist>
EOF
codesign --force --sign - --entitlements resources/AeroSpace.entitlements "$app"
echo "built $app"

#!/usr/bin/env bash
# Apply a 43PR-style theme (GTK colors.css file) to sketchybar and Ghostty.
# usage: skyland-theme dark | light | toggle | apply | pick | set <file> | off
#   dark/light/toggle  pick the [theme] file from the skyland config and apply it
#   pick               choose a theme of the [theme] folder in the picker (alt-shift-l)
#   set <file>         apply <file> until toggle / dark / light or a new wallpaper
#   apply              re-apply the current mode (default dark)
#   off                remove the generated files (work profile)
# Theme files: `@define-color <key> #rrggbb;`, keys of the 43PR palette.
# With [wallpaper] dynamic-colors, the dark/light files generated from the
# wallpaper by skyland-wallpaper are used instead of the [theme] ones.
# Ghostty picks the colors through `config-file = ?~/.cache/skyland/ghostty.conf`
# in its config, and reloads on SIGUSR2.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE="$HOME/.cache/skyland"
MODE_FILE="$CACHE/theme-mode"
CHOSEN_FILE="$CACHE/theme-file" # theme picked with `pick` / `set`, over [theme] and the wallpaper colors
PICKER="${SKYLAND_PICKER:-$REPO/.build/skyland-wallpaper-picker}"
REQUIRED="bg fg fg_dim bg_card bg_hover border border_strong accent cursor cursor_text selection_bg selection_fg
    term0 term1 term2 term3 term4 term5 term6 term7 term8 term9 term10 term11 term12 term13 term14 term15"

die() { echo "skyland-theme: $*" >&2; exit 1; }

# Ghostty reloads its whole config on SIGUSR2. Be gentle with the user's
# terminals: reload only when the colors file really changed, and coalesce
# calls within 0.5 s (wallpaper set + theme apply, toggles in a row) into one
# signal. Several reloads in a burst coincided with a hung Ghostty (2026-10-14).
reload_ghostty() {
    local token="$$-$RANDOM"
    echo "$token" > "$CACHE/ghostty-reload"
    (
        sleep 0.5
        [[ "$(cat "$CACHE/ghostty-reload" 2>/dev/null)" == "$token" ]] && pkill -USR2 -x ghostty
    ) >/dev/null 2>&1 &
}

# Replace $CACHE/ghostty.conf with stdin; reload Ghostty only if it changed
update_ghostty_conf() {
    local new="$CACHE/ghostty.conf.new"
    cat > "$new"
    if cmp -s "$new" "$CACHE/ghostty.conf"; then
        rm -f "$new"
    else
        mv "$new" "$CACHE/ghostty.conf"
        reload_ghostty
    fi
}

mode="$(cat "$MODE_FILE" 2>/dev/null || echo dark)"
case "${1:-apply}" in
    dark | light) mode="$1"; rm -f "$CHOSEN_FILE" ;;
    toggle) [[ "$mode" == dark ]] && mode=light || mode=dark; rm -f "$CHOSEN_FILE" ;;
    apply) ;;
    pick)
        [[ -x "$PICKER" ]] || die "picker not built: run bin/skyland-build"
        pkill -f "$PICKER" && exit 0 # a picker open already: the key closes it
        themes=("$(dirname "$("$REPO/bin/skyland-config" theme dark)")"/*.css)
        for wallpaper in "$CACHE/themes/wallpaper-dark.css" "$CACHE/themes/wallpaper-light.css"; do
            [[ -r "$wallpaper" ]] && themes+=("$wallpaper")
        done
        file="$(SKYLAND_PICKER_SELECTED="$(cat "$CHOSEN_FILE" 2>/dev/null)" "$PICKER" --themes "${themes[@]}")" || exit 0 # cancelled
        exec "$0" set "$file"
        ;;
    set)
        [[ -r "${2:-}" ]] || die "cannot read '${2:-}'"
        echo "$2" > "$CHOSEN_FILE"
        ;;
    off)
        rm -f "$CACHE/theme.env"
        if [[ -f "$CACHE/ghostty.conf" ]]; then
            rm -f "$CACHE/ghostty.conf"
            reload_ghostty
        fi
        exit 0
        ;;
    *) die "usage: skyland-theme dark | light | toggle | apply | pick | set <file> | off" ;;
esac

file="$("$REPO/bin/skyland-config" theme "$mode")"
if [[ "$("$REPO/bin/skyland-config" wallpaper dynamic-colors)" == true && -r "$CACHE/themes/wallpaper-$mode.css" ]]; then
    file="$CACHE/themes/wallpaper-$mode.css"
fi
chosen="$(cat "$CHOSEN_FILE" 2>/dev/null || true)"
[[ -n "$chosen" && -r "$chosen" ]] && file="$chosen"
[[ -n "$file" ]] || die "no '$mode' in [theme] of the config"
[[ -r "$file" ]] || die "cannot read $file"

# `@define-color key #rrggbb;` -> shell variables c_key=rrggbb
colors="$(awk '
    match($0, /^[[:space:]]*@define-color[[:space:]]+[A-Za-z0-9_]+[[:space:]]+#[0-9A-Fa-f]{6}[[:space:]]*;/) {
        split($0, f, /[[:space:]#;]+/); print "c_" f[2] "=" tolower(f[3])
    }' "$file")"
eval "$colors"
missing=""
for key in $REQUIRED; do
    var="c_$key"
    [[ -n "${!var:-}" ]] || missing="$missing $key"
done
[[ -z "$missing" ]] || die "$file is missing:$missing"
if [[ -n "$chosen" && "$file" == "$chosen" ]]; then # mode of a chosen theme: from its background
    (( (16#${c_bg:0:2} * 299 + 16#${c_bg:2:2} * 587 + 16#${c_bg:4:2} * 114) / 1000 < 128 )) && mode=dark || mode=light
fi

mkdir -p "$CACHE"
echo "$mode" > "$MODE_FILE"

{
    echo "# generated by skyland-theme" # no source path: identical colors must give an identical file
    echo "background = #$c_bg"
    echo "foreground = #$c_fg"
    echo "cursor-color = #$c_cursor"
    echo "cursor-text = #$c_cursor_text"
    echo "selection-background = #$c_selection_bg"
    echo "selection-foreground = #$c_selection_fg"
    blur="$("$REPO/bin/skyland-config" decoration blur)"
    [[ "${blur:-0}" -gt 0 ]] && echo "background-blur = $blur" # [decoration] blur, 43PR blur size 5
    for i in $(seq 0 15); do
        var="c_term$i"
        echo "palette = $i=#${!var}"
    done
} | update_ghostty_conf

# sketchybar colors are 0xAARRGGBB; read by profiles/hypr/sketchybar/*.sh
cat > "$CACHE/theme.env" <<EOF
# generated by skyland-theme from $file
BAR_BG=0xff$c_bg
TEXT=0xff$c_fg
TEXT_DIM=0xff$c_fg_dim
ITEM_BG=0xff$c_bg_card
ITEM_BG_ACTIVE=0xff$c_bg_hover
BORDER=0xff$c_border
BORDER_ACTIVE=0xff$c_border_strong
ACCENT=0xff$c_accent
EOF

if sketchybar --query bar >/dev/null 2>&1; then
    # 43PR is monochrome: every item takes the theme colors
    sketchybar --bar color=0xff$c_bg border_color=0xff$c_border \
        --set '/.*/' icon.color=0xff$c_fg label.color=0xff$c_fg_dim \
            background.color=0xff$c_bg_card background.border_color=0xff$c_border \
        --trigger skyland_update
fi
# [decoration] border-width: focused window border, accent -> highlight gradient
# (Hyprland col.active_border). A second `borders` call updates the running one.
# With border-rotate-ms skyland draws a rotating border itself: no JankyBorders.
width="$("$REPO/bin/skyland-config" decoration border-width)"
rotate="$("$REPO/bin/skyland-config" decoration border-rotate-ms)"
if [[ "${width:-0}" -gt 0 && "${rotate:-0}" -eq 0 ]] && command -v borders >/dev/null; then
    nohup borders style=round hidpi=on width="$width.0" inactive_color=0x00000000 \
        active_color="gradient(top_left=0xff$c_accent,bottom_right=0xff${c_highlight:-$c_accent})" >/dev/null 2>&1 &
else
    pkill -x borders 2>/dev/null || true # only the hypr profile runs skyland-theme
fi
cp "$file" "$CACHE/theme.css" # current theme, for skyland-lock
"$REPO/bin/skyland-lock" refresh || true
"$REPO/bin/skyland-appearance" apply || true # [appearance]: macOS dark mode and colors (optional)
echo "theme: $mode ($file)"

#!/usr/bin/env bash
# Apply a 43PR-style theme (GTK colors.css file) to sketchybar and Ghostty.
# usage: skyland-theme dark | light | toggle | apply | off
#   dark/light/toggle  pick the [theme] file from the skyland config and apply it
#   apply              re-apply the current mode (default dark)
#   off                remove the generated files (work profile)
# Theme files: `@define-color <key> #rrggbb;`, keys of the 43PR palette.
# With [wallpaper] dynamic-colors, the dark/light files generated from the
# wallpaper by skyland-wallpaper are used instead of the [theme] ones.
# Ghostty picks the colors through `config-file = ?~/.cache/skyland/ghostty.conf`
# in its config, and reloads on SIGUSR2.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE="$HOME/.cache/skyland"
MODE_FILE="$CACHE/theme-mode"
REQUIRED="bg fg fg_dim bg_card bg_hover border border_strong accent cursor cursor_text selection_bg selection_fg
    term0 term1 term2 term3 term4 term5 term6 term7 term8 term9 term10 term11 term12 term13 term14 term15"

die() { echo "skyland-theme: $*" >&2; exit 1; }

reload_ghostty() { pkill -USR2 -x ghostty 2>/dev/null || true; }

mode="$(cat "$MODE_FILE" 2>/dev/null || echo dark)"
case "${1:-apply}" in
    dark | light) mode="$1" ;;
    toggle) [[ "$mode" == dark ]] && mode=light || mode=dark ;;
    apply) ;;
    off)
        rm -f "$CACHE/ghostty.conf" "$CACHE/theme.env"
        reload_ghostty
        exit 0
        ;;
    *) die "usage: skyland-theme dark | light | toggle | apply | off" ;;
esac

file="$("$REPO/bin/skyland-config" theme "$mode")"
if [[ "$("$REPO/bin/skyland-config" wallpaper dynamic-colors)" == true && -r "$CACHE/themes/wallpaper-$mode.css" ]]; then
    file="$CACHE/themes/wallpaper-$mode.css"
fi
[[ -n "$file" ]] || die "no '$mode' in [theme] of the config"
[[ -r "$file" ]] || die "cannot read $file"

# `@define-color key #rrggbb;` -> shell variables c_key=rrggbb
colors="$(awk '
    match($0, /^[[:space:]]*@define-color[[:space:]]+[A-Za-z0-9_]+[[:space:]]+#[0-9A-Fa-f]{6}[[:space:]]*;/) {
        split($0, f, /[[:space:]#;]+/); print "c_" f[2] "=" tolower(f[3])
    }' "$file")"
eval "$colors"
missing=""
for key in $REQUIRED; do
    var="c_$key"
    [[ -n "${!var:-}" ]] || missing="$missing $key"
done
[[ -z "$missing" ]] || die "$file is missing:$missing"

mkdir -p "$CACHE"
echo "$mode" > "$MODE_FILE"

{
    echo "# generated by skyland-theme from $file"
    echo "background = #$c_bg"
    echo "foreground = #$c_fg"
    echo "cursor-color = #$c_cursor"
    echo "cursor-text = #$c_cursor_text"
    echo "selection-background = #$c_selection_bg"
    echo "selection-foreground = #$c_selection_fg"
    for i in $(seq 0 15); do
        var="c_term$i"
        echo "palette = $i=#${!var}"
    done
} > "$CACHE/ghostty.conf"
reload_ghostty

# sketchybar colors are 0xAARRGGBB; read by profiles/hypr/sketchybar/*.sh
cat > "$CACHE/theme.env" <<EOF
# generated by skyland-theme from $file
BAR_BG=0xff$c_bg
TEXT=0xff$c_fg
TEXT_DIM=0xff$c_fg_dim
ITEM_BG=0xff$c_bg_card
ITEM_BG_ACTIVE=0xff$c_bg_hover
BORDER=0xff$c_border
BORDER_ACTIVE=0xff$c_border_strong
ACCENT=0xff$c_accent
EOF

if sketchybar --query bar >/dev/null 2>&1; then
    # 43PR is monochrome: every item takes the theme colors
    sketchybar --bar color=0xff$c_bg border_color=0xff$c_border \
        --set '/.*/' icon.color=0xff$c_fg label.color=0xff$c_fg_dim \
            background.color=0xff$c_bg_card background.border_color=0xff$c_border \
        --trigger skyland_update
fi
cp "$file" "$CACHE/theme.css" # current theme, for skyland-lock
"$REPO/bin/skyland-lock" refresh || true
echo "theme: $mode ($file)"

#!/usr/bin/env bash
# Wallpaper picker and wallpaper-based colors, like 43PR (hyprquickpaper + matugen).
# usage: skyland-wallpaper pick | set <file> | fetch [wallhaven-user | user/favorites/[collection-id]]
#   pick   choose an image of [wallpaper] dir in a picker, then `set` it
#   set    make <file> the wallpaper of every screen; with dynamic-colors, generate
#          dark/light themes from it (matugen) and apply the current mode
#   fetch  download the SFW uploads of a wallhaven user (default 43pr) into dir, or
#          a public collection user/id (e.g. 43PR/1262809) into dir/<collection label>,
#          or every public collection of a user with user/ (e.g. 43PR/). The
#          collection page path or URL works too: 43PR/favorites/1262809,
#          https://wallhaven.cc/user/43PR/favorites/1262809, 43PR/favorites.
#          `pick` shows those theme folders first, then the wallpapers of the chosen one
#
# [wallpaper]
# dir = '~/Pictures/Wallpapers'
# dynamic-colors = true       # theme colors from the wallpaper instead of [theme] files
# prefer = 'saturation'       # matugen --prefer when the image has several source colors
# scheme = 'auto'             # matugen scheme; auto = monochrome for grayscale images, else content
# auto-mode = true            # light theme for a bright wallpaper, dark for a dark one (alt-l still toggles)
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE="$HOME/.cache/skyland"
PICKER="${SKYLAND_PICKER:-$REPO/.build/skyland-wallpaper-picker}"
MAPPING="$REPO/profiles/hypr/.config/skyland/wallpaper-colors.json" # 43PR semantic.json roles
conf() { "$REPO/bin/skyland-config" wallpaper "$1"; }
die() { echo "skyland-wallpaper: $*" >&2; exit 1; }

dir="$(conf dir)"
dir="${dir:-$HOME/Pictures/Wallpapers}"

generate_colors() { # image
    local matugen json mode scheme
    matugen="$(command -v matugen || echo "$HOME/.cargo/bin/matugen")" # skyland runs commands with a short PATH
    [[ -x "$matugen" ]] || die "matugen not found (cargo install matugen)"
    # Material always invents a hue, even for a black and white image: use the
    # monochrome scheme below a mean chroma of 0.03 (sketches, rainy grey cities),
    # else content, which keeps the image colors (tonal-spot, matugen's default, mutes them)
    scheme="$(conf scheme | grep . || echo auto)"
    if [[ "$scheme" == auto ]]; then
        scheme=scheme-content
        awk -v s="$("$PICKER" --saturation "$1")" 'BEGIN { exit !(s < 0.03) }' && scheme=scheme-monochrome
    fi
    json="$("$matugen" image "$1" --json hex --dry-run -t "$scheme" --prefer "$(conf prefer | grep . || echo saturation)")"
    mkdir -p "$CACHE/themes"
    for mode in dark light; do
        {
            echo "/* generated by skyland-wallpaper from $1 (matugen $scheme, $mode), 43PR semantic roles */"
            jq -r --slurpfile map "$MAPPING" --arg mode "$mode" \
                '.colors as $c | $map[0] | to_entries[] | "@define-color \(.key) \($c[.value][$mode].color);"' <<<"$json"
        } > "$CACHE/themes/wallpaper-$mode.css.tmp"
        mv "$CACHE/themes/wallpaper-$mode.css.tmp" "$CACHE/themes/wallpaper-$mode.css"
    done
}

download() { # api-url-prefix dest-dir
    local page urls url name
    mkdir -p "$2"
    for page in $(seq 1 100); do
        urls="$(curl -sf "${1}page=$page" | jq -r '.data[].path')"
        [[ -n "$urls" ]] || break
        while read -r url; do
            name="${url##*/}"
            [[ -f "$2/$name" ]] && continue
            if [[ -f "$dir/$name" ]]; then # loose from an older fetch: file it under the theme
                mv "$dir/$name" "$2/$name" && echo "$name (moved)"
                continue
            fi
            curl -sfL -o "$2/$name.part" "$url" && mv "$2/$name.part" "$2/$name" && echo "$name"
            sleep 0.5 # be gentle with wallhaven
        done <<<"$urls"
    done
}

case "${1:-}" in
    pick)
        [[ -x "$PICKER" ]] || die "picker not built: run bin/skyland-build"
        # A resident picker: shown or hidden by SIGUSR1, no app to start (about 200 ms each time
        # before). The first pick starts it, shown; it sets the wallpaper itself ($0 set).
        mkdir -p "$CACHE"
        echo "$dir" > "$CACHE/picker-dir"
        pid="$(cat "$CACHE/picker.pid" 2>/dev/null || true)"
        # the pid must still be the picker: SIGUSR1 ends most other processes
        if [[ -n "$pid" ]] && ps -p "$pid" -o command= 2>/dev/null | grep -q -- "--resident"; then
            kill -USR1 "$pid"
            exit 0
        fi
        SKYLAND_WALLPAPER_SET="$REPO/bin/skyland-wallpaper" nohup "$PICKER" --resident "$dir" >/dev/null 2>&1 &
        ;;
    set)
        file="${2:-}"
        [[ -r "$file" ]] || die "cannot read '$file'"
        "$PICKER" --set "$file"
        mkdir -p "$CACHE"
        echo "$file" > "$CACHE/wallpaper"
        mode=apply # keep the current light / dark mode
        if [[ "$(conf auto-mode)" == true ]]; then
            # ponytail: fixed threshold on the mean luminance, make it a setting if 0.5 picks wrong
            mode="$(awk -v l="$("$PICKER" --luminance "$file")" 'BEGIN { print (l > 0.5 ? "light" : "dark") }')"
        fi
        if [[ "$(conf dynamic-colors)" == true ]]; then
            generate_colors "$file"
            rm -f "$CACHE/theme-file" # a new wallpaper takes over a theme chosen in the picker
            "$REPO/bin/skyland-theme" "$mode" # also refreshes the lock screen
        else
            # still generated, not applied: for apps on the wallpaper colors (skyland-cyberdeck theme wallpaper)
            (generate_colors "$file") >/dev/null 2>&1 || true
            if [[ "$mode" != apply ]]; then
                "$REPO/bin/skyland-theme" "$mode" # the [theme] dark / light files
            else
                "$REPO/bin/skyland-lock" refresh
            fi
        fi
        ;;
    fetch)
        src="${2:-43pr}"
        # wallhaven page forms -> user/id: [https://wallhaven.cc/]user/<u>/favorites[/<id>]
        src="${src#https://}"; src="${src#wallhaven.cc/}"; src="${src#user/}"
        [[ "$src" == */favorites* ]] && { src="${src/\/favorites/}"; [[ "$src" == */* ]] || src="$src/"; }
        mkdir -p "$dir"
        if [[ "$src" != */* ]]; then
            download "https://wallhaven.cc/api/v1/search?q=@$src&purity=100&" "$dir"
            exit
        fi
        # user/id: one public collection; user/ : all of them. One theme folder per
        # collection, named after its label ('/' in a label becomes U+2215 '∕')
        user="${src%%/*}" id="${src#*/}"
        curl -sf "https://wallhaven.cc/api/v1/collections/$user" |
            jq -r --arg id "$id" '.data[] | select($id == "" or (.id | tostring) == $id) | "\(.id)\t\(.label)"' |
            while IFS=$'\t' read -r cid label; do
                echo "== $label"
                download "https://wallhaven.cc/api/v1/collections/$user/$cid?" "$dir/${label//\//∕}"
            done
        ;;
    *)
        die "usage: skyland-wallpaper pick | set <file> | fetch [wallhaven-user | user/favorites/[collection-id]]"
        ;;
esac

#!/usr/bin/env bash
# Wallpaper picker and wallpaper-based colors, like 43PR (hyprquickpaper + matugen).
# usage: skyland-wallpaper pick | set <file> | fetch [wallhaven-user | user/[collection-id]]
#   pick   choose an image of [wallpaper] dir in a picker, then `set` it
#   set    make <file> the wallpaper of every screen; with dynamic-colors, generate
#          dark/light themes from it (matugen) and apply the current mode
#   fetch  download the SFW uploads of a wallhaven user (default 43pr) into dir, or
#          a public collection user/id (e.g. 43PR/1262809) into dir/<collection label>,
#          or every public collection of a user with user/ (e.g. 43PR/).
#          `pick` shows those theme folders first, then the wallpapers of the chosen one
#
# [wallpaper]
# dir = '~/Pictures/Wallpapers'
# dynamic-colors = true       # theme colors from the wallpaper instead of [theme] files
# prefer = 'saturation'       # matugen --prefer when the image has several source colors
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CACHE="$HOME/.cache/skyland"
PICKER="${SKYLAND_PICKER:-$REPO/.build/skyland-wallpaper-picker}"
MAPPING="$REPO/profiles/hypr/.config/skyland/wallpaper-colors.json" # 43PR semantic.json roles
conf() { "$REPO/bin/skyland-config" wallpaper "$1"; }
die() { echo "skyland-wallpaper: $*" >&2; exit 1; }

dir="$(conf dir)"
dir="${dir:-$HOME/Pictures/Wallpapers}"

generate_colors() { # image
    local matugen json mode
    matugen="$(command -v matugen || echo "$HOME/.cargo/bin/matugen")" # skyland runs commands with a short PATH
    [[ -x "$matugen" ]] || die "matugen not found (cargo install matugen)"
    json="$("$matugen" image "$1" --json hex --dry-run --prefer "$(conf prefer | grep . || echo saturation)")"
    mkdir -p "$CACHE/themes"
    for mode in dark light; do
        {
            echo "/* generated by skyland-wallpaper from $1 (matugen, $mode), 43PR semantic roles */"
            jq -r --slurpfile map "$MAPPING" --arg mode "$mode" \
                '.colors as $c | $map[0] | to_entries[] | "@define-color \(.key) \($c[.value][$mode].color);"' <<<"$json"
        } > "$CACHE/themes/wallpaper-$mode.css.tmp"
        mv "$CACHE/themes/wallpaper-$mode.css.tmp" "$CACHE/themes/wallpaper-$mode.css"
    done
}

download() { # api-url-prefix dest-dir
    local page urls url name
    mkdir -p "$2"
    for page in $(seq 1 100); do
        urls="$(curl -sf "${1}page=$page" | jq -r '.data[].path')"
        [[ -n "$urls" ]] || break
        while read -r url; do
            name="${url##*/}"
            [[ -f "$2/$name" ]] && continue
            if [[ -f "$dir/$name" ]]; then # loose from an older fetch: file it under the theme
                mv "$dir/$name" "$2/$name" && echo "$name (moved)"
                continue
            fi
            curl -sfL -o "$2/$name.part" "$url" && mv "$2/$name.part" "$2/$name" && echo "$name"
            sleep 0.5 # be gentle with wallhaven
        done <<<"$urls"
    done
}

case "${1:-}" in
    pick)
        [[ -x "$PICKER" ]] || die "picker not built: run bin/skyland-build"
        file="$("$PICKER" "$dir")" || exit 0 # cancelled
        exec "$0" set "$file"
        ;;
    set)
        file="${2:-}"
        [[ -r "$file" ]] || die "cannot read '$file'"
        "$PICKER" --set "$file"
        mkdir -p "$CACHE"
        echo "$file" > "$CACHE/wallpaper"
        if [[ "$(conf dynamic-colors)" == true ]]; then
            generate_colors "$file"
            "$REPO/bin/skyland-theme" apply # also refreshes the lock screen
        else
            "$REPO/bin/skyland-lock" refresh
        fi
        ;;
    fetch)
        src="${2:-43pr}"
        mkdir -p "$dir"
        if [[ "$src" != */* ]]; then
            download "https://wallhaven.cc/api/v1/search?q=@$src&purity=100&" "$dir"
            exit
        fi
        # user/id: one public collection; user/ : all of them. One theme folder per
        # collection, named after its label ('/' in a label becomes U+2215 '∕')
        user="${src%%/*}" id="${src#*/}"
        curl -sf "https://wallhaven.cc/api/v1/collections/$user" |
            jq -r --arg id "$id" '.data[] | select($id == "" or (.id | tostring) == $id) | "\(.id)\t\(.label)"' |
            while IFS=$'\t' read -r cid label; do
                echo "== $label"
                download "https://wallhaven.cc/api/v1/collections/$user/$cid?" "$dir/${label//\//∕}"
            done
        ;;
    *)
        die "usage: skyland-wallpaper pick | set <file> | fetch [wallhaven-user | user/[collection-id]]"
        ;;
esac

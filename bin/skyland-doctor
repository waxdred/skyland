#!/usr/bin/env bash
# Check a skyland install and say what to fix.
# usage: skyland doctor
# ✓ fine, ! optional part missing (what it gives), ✗ broken (exit 1)
set -uo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
CLI="$REPO/.build/aerospace"
conf() { "$REPO/bin/skyland-config" "$@"; }
failed=0
ok() { printf '  \033[32m✓\033[0m %s\n' "$*"; }
opt() { printf '  \033[33m!\033[0m %s\n' "$1"; [[ -n "${2:-}" ]] && printf '      %s\n' "$2"; }
bad() { printf '  \033[31m✗\033[0m %s\n' "$1"; [[ -n "${2:-}" ]] && printf '      %s\n' "$2"; failed=1; }
section() { printf '\n\033[1m%s\033[0m\n' "$*"; }

section "System"
ok "macOS $(sw_vers -productVersion), $(uname -m)"
[[ "$(uname -m)" == arm64 ]] || opt "only tested on Apple Silicon"

section "skyland"
if [[ -d "$REPO/.build/Skyland.app" && -x "$CLI" ]]; then ok "built (.build/Skyland.app)"; else bad "not built" "run: skyland install (or bin/skyland-build)"; fi
if command -v skyland >/dev/null; then ok "skyland CLI on PATH ($(command -v skyland))"; else opt "skyland CLI not on PATH" "ln -s $REPO/bin/skyland ~/.local/bin/skyland, and add ~/.local/bin to PATH"; fi
if pgrep -xq Skyland; then
    if "$CLI" list-workspaces --focused </dev/null >/dev/null 2>&1; then
        ok "Skyland.app running, server answers"
    else
        bad "Skyland.app running but its server does not answer" "Accessibility not granted yet? System Settings > Privacy & Security > Accessibility > Skyland"
    fi
else
    bad "Skyland.app not running" "open $REPO/.build/Skyland.app (never start the binary from a terminal: it resets its Accessibility permission)"
fi
if "$CLI" reload-config --dry-run </dev/null >/dev/null 2>&1; then ok "config valid ($(readlink -f ~/.config/aerospace/aerospace.toml 2>/dev/null || echo ~/.config/aerospace/aerospace.toml))"
elif pgrep -xq Skyland; then bad "config has errors" "skyland reload-config --dry-run"; fi
windows="$("$CLI" list-windows --all --format '%{window-id}' </dev/null 2>/dev/null | wc -l | tr -d ' ')"
if [[ "${windows:-0}" -gt 0 ]]; then ok "manages $windows windows (Accessibility works)"
elif pgrep -xq Skyland; then opt "no window managed" "no app open, or Accessibility not granted to Skyland"; fi
case "$(cat "$HOME/.cache/skyland/screen-recording" 2>/dev/null)" in # written by Skyland at start
    yes) ok "Screen Recording for Skyland (live thumbnails in the overview and the switcher)" ;;
    no) opt "Screen Recording not allowed to Skyland" "System Settings > Privacy & Security > Screen Recording: allow Skyland, then restart it (live thumbnails instead of app icons)" ;;
    *) opt "Screen Recording for Skyland: unknown (start Skyland once)" "System Settings > Privacy & Security > Screen Recording" ;;
esac

# trackpad swipe vs the macOS gesture with as many fingers (2 = on: full-screen apps /
# Mission Control), built-in and Magic Trackpad
if [[ "$("$REPO/bin/skyland-config" gestures workspace-swipe)" == true ]]; then
    fingers="$("$REPO/bin/skyland-config" gestures workspace-swipe-fingers)"
    axis=Horiz; [[ "$("$REPO/bin/skyland-config" gestures workspace-swipe-direction)" == vertical ]] && axis=Vert
    word=Three; [[ "${fingers:-3}" == 4 ]] && word=Four
    conflict=""
    for domain in com.apple.AppleMultitouchTrackpad com.apple.driver.AppleBluetoothMultitouch.trackpad; do
        [[ "$(defaults read "$domain" "Trackpad${word}Finger${axis}SwipeGesture" 2>/dev/null)" == 2 ]] && conflict=1
    done
    gesture="Swipe between full-screen applications"; [[ $axis == Vert ]] && gesture="Mission Control / App Exposé"
    if [[ -n "$conflict" ]]; then
        opt "trackpad: macOS also uses the ${fingers:-3}-finger $( [[ $axis == Vert ]] && echo vertical || echo horizontal ) swipe" "System Settings > Trackpad > More Gestures: $gesture to 4 fingers or off (or workspace-swipe-fingers = 4)"
    else
        ok "trackpad: ${fingers:-3}-finger swipe free for workspaces"
    fi
fi

section "Window effects (optional: corners, opacity, animations, floating on top)"
sip="$(csrutil status 2>/dev/null)"
if grep -q "Filesystem Protections: disabled" <<<"$sip" && grep -q "Debugging Restrictions: disabled" <<<"$sip"; then
    ok "SIP partially disabled (filesystem + debugging)"
else
    opt "SIP not disabled: skyland works, without window effects" "to enable them: https://github.com/koekeishiya/yabai/wiki/Disabling-System-Integrity-Protection"
fi
if nvram boot-args 2>/dev/null | grep -q -- -arm64e_preview_abi; then ok "boot-arg -arm64e_preview_abi"
else opt "boot-arg -arm64e_preview_abi missing (needed with SIP off)" "sudo nvram boot-args=-arm64e_preview_abi, then reboot"; fi
loader=/Library/ScriptingAdditions/skyland.osax/Contents/MacOS/loader
if [[ -x "$loader" ]]; then ok "scripting addition installed"; else opt "scripting addition not installed" "skyland sa build && skyland sa load"; fi
reply="$(echo ping | nc -U -w1 "/tmp/skyland-sa_$(whoami).socket" 2>/dev/null)"
if [[ "$reply" == ok* ]]; then
    ok "payload loaded in Dock (${reply#ok })"
    [[ "$reply" == *track* ]] || opt "old payload (no animation tracks, floating on top...)" "skyland sa build && killall Dock && sleep 3 && skyland sa load"
elif [[ -x "$loader" ]]; then
    bad "payload not loaded (after a reboot or killall Dock)" "skyland sa load"
fi
if [[ -x "$loader" ]]; then
    if sudo -n -l "$loader" >/dev/null 2>&1; then ok "sudoers rule matches the loader (loads at login without password)"
    elif [[ -f /private/etc/sudoers.d/skyland ]]; then bad "sudoers rule is stale (the loader changed after a rebuild)" "skyland sa load (renews it)"
    else opt "no sudoers rule: the payload is not loaded at login" "skyland sa load, answer y"; fi
fi

section "Autostart (optional)"
if launchctl print "gui/$(id -u)/com.waxdred.skyland" >/dev/null 2>&1; then ok "LaunchAgent com.waxdred.skyland loaded"
else opt "no LaunchAgent: start skyland by hand after a login" "README > Autostart, step 2"; fi

section "Bar, border, colors"
if pgrep -xq skylandbar; then
    ok "skylandbar running (the bar)"
elif pgrep -xq sketchybar; then
    if sketchybar --query workspace.1 >/dev/null 2>&1; then ok "sketchybar with skyland workspaces"
    else opt "sketchybar runs without skyland workspaces" "end your sketchybarrc with: [ -x \"\$HOME/.local/bin/skyland\" ] && \"\$HOME/.local/bin/skyland\" bar >/dev/null 2>&1 &"; fi
else
    opt "no bar running" "brew install waxdred/tap/skylandbar (skyland starts it), or sketchybar"
fi
if [[ "$(conf decoration border-width)" =~ ^[1-9] ]]; then
    if command -v borders >/dev/null; then ok "borders installed (focused window border)"
    else bad "[decoration] border-width is set but borders is missing" "brew install felixkratz/formulae/borders"; fi
fi
if [[ "$(conf wallpaper dynamic-colors)" == true ]]; then
    if command -v matugen >/dev/null || [[ -x "$HOME/.cargo/bin/matugen" ]]; then ok "matugen (colors from the wallpaper)"
    else bad "[wallpaper] dynamic-colors is on but matugen is missing" "cargo install matugen"; fi
fi
term="$(conf terminal app)"; term="${term:-Ghostty}"
if [[ -d "/Applications/$term.app" || -d "$HOME/Applications/$term.app" ]]; then ok "terminal: $term"
else opt "terminal app '$term' not found in /Applications" "set [terminal] app in the config"; fi

echo
if (( failed )); then echo "Fix the ✗ above."; exit 1; fi
echo "All good."

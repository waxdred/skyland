#!/usr/bin/env bash
# Floating media widget (tools/media-widget), on every workspace, drag it with the mouse.
# usage: skyland-media toggle | open | close | restart (only if open, e.g. new opacity)
#
# [media]
# opacity = 92          # percent, whole widget
# style = 'classic'     # classic (glass, theme colors, bars) | audioware (cyan light wave)
# theme = 'skyland'     # skyland (follows [decoration] ui-style) | metal | glass | glyph
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
WIDGET="$REPO/.build/skyland-media"

open_widget() {
    [[ -x "$WIDGET" ]] || { echo "skyland-media: not built, run bin/skyland-build" >&2; exit 1; }
    opacity="$("$REPO/bin/skyland-config" media opacity)"
    style="$("$REPO/bin/skyland-config" media style)"
    look="$("$REPO/bin/skyland-config" media theme)"
    nohup "$WIDGET" --opacity "${opacity:-92}" --style "${style:-classic}" --look "${look:-skyland}" >/dev/null 2>&1 &
}

case "${1:-toggle}" in
    toggle) pkill -x skyland-media || open_widget ;;
    open) pgrep -xq skyland-media || open_widget ;;
    close) pkill -x skyland-media || true ;;
    restart) pkill -x skyland-media && sleep 0.3 && open_widget || true ;;
    *) echo "usage: skyland-media toggle | open | close | restart" >&2; exit 1 ;;
esac

#!/usr/bin/env bash
# Switch between the work setup (yabai + skhd) and the skyland setup.
# usage: skyland-env work|hypr|status
#
# Profile "hypr" is an overlay: each entry of profiles/hypr/.config is linked
# into ~/.config. Switching back to "work" relinks those entries to the work
# dotfiles (or removes them when work has no such entry).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
HYPR="$REPO/profiles/hypr/.config"
WORK="${SKYLAND_WORK_CONFIG:-$HOME/tools/dotfiles/.config}"
APP="${SKYLAND_APP:-$REPO/.build/Skyland.app}"
STATE="$HOME/.config/.skyland-profile"

# Only touch symlinks or missing paths, never a real file or dir.
link() { # src dest
    if [[ -e "$2" && ! -L "$2" ]]; then
        echo "skip $2: real file, move it away first" >&2
        return
    fi
    ln -sfn "$1" "$2"
}

relink() { # profile_dir
    for entry in "$HYPR"/* "$HYPR"/.[!.]*; do
        [[ -e "$entry" ]] || continue
        local name dest
        name="$(basename "$entry")"
        dest="$HOME/.config/$name"
        if [[ -e "$1/$name" ]]; then
            link "$1/$name" "$dest"
        elif [[ -L "$dest" && "$(readlink "$dest")" == "$HYPR"/* ]]; then
            rm "$dest"
        fi
    done
}

# skyland workspaces replace macOS Spaces and expect one Space per display.
# Offers to destroy the others through the running yabai (and its scripting
# addition); macOS moves their windows to a remaining Space, nothing is closed.
# Native fullscreen Spaces stay. Asks first, skips without a terminal.
collapse_spaces() {
    # yabai may have just been started by `skyland-env work`: give it time to answer
    local tries=0
    until yabai -m query --spaces >/dev/null 2>&1; do
        if ! pgrep -xq yabai || (( ++tries > 20 )); then
            echo "yabai not available: extra macOS Spaces not checked (run skyland-env work first)" >&2
            return 0
        fi
        sleep 0.5
    done
    local spaces extra
    spaces=$(yabai -m query --spaces)
    extra=$(jq -r 'group_by(.display) | map(sort_by(.index) | .[1:][]
        | select(."is-native-fullscreen" | not) | .index) | flatten | sort | reverse | .[]' <<<"$spaces")
    [[ -n "$extra" ]] || return 0
    echo "skyland uses one macOS Space per display. These Spaces would be removed"
    echo "(their windows move to a remaining Space, nothing is closed):"
    for index in $extra; do
        jq -r --argjson i "$index" '.[] | select(.index == $i)
            | "  Space \(.index) \(if .label != "" then "(\(.label))" else "" end) on display \(.display): \(.windows | length) window(s)"' <<<"$spaces"
    done
    if [[ ! -r /dev/tty ]] || ! { exec 3</dev/tty; } 2>/dev/null; then
        echo "no terminal to confirm, Spaces kept (windows on other Spaces may tile together)" >&2
        return 0
    fi
    local answer
    read -r -u 3 -p "Remove them? [y/N] " answer || answer= # EOF = no
    exec 3<&-
    [[ "$answer" == [yY]* ]] || { echo "Spaces kept"; return 0; }
    for index in $extra; do
        yabai -m space --destroy "$index" || true # highest first, lower indices stay valid
    done
}

case "${1:-status}" in
    hypr)
        collapse_spaces
        yabai --stop-service 2>/dev/null || true
        skhd --stop-service 2>/dev/null || true
        pkill -x borders 2>/dev/null || true
        relink "$HYPR"
        open "$APP"
        ;;
    work)
        # SIGTERM: the app intercepts it to restore hidden windows and their alpha
        pkill -x AeroSpaceApp 2>/dev/null || true
        relink "$WORK"
        yabai --start-service 2>/dev/null || true
        skhd --start-service 2>/dev/null || true
        # recreate the work Spaces that the hypr profile collapsed
        spaces="$WORK/yabai/script/generate-workspace.sh"
        [[ -x "$spaces" ]] && { sleep 2; "$spaces"; } >/dev/null 2>&1 &
        ;;
    status)
        cat "$STATE" 2>/dev/null || echo work
        exit 0
        ;;
    *)
        echo "usage: skyland-env work|hypr|status" >&2
        exit 1
        ;;
esac

echo "$1" > "$STATE"
sketchybar --reload 2>/dev/null || true
echo "profile: $1"

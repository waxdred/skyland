#!/usr/bin/env bash
# Set up skyland: link the hypr profile into ~/.config, start Skyland.app, reload
# sketchybar with the skyland workspaces. Run at login by the LaunchAgent.
# usage: skyland-env [hypr] | status
#
# Each entry of profiles/hypr/.config is linked into ~/.config (only symlinks or
# missing paths are touched, never a real file or dir). skyland workspaces replace
# macOS Spaces: keep one Space per display (Mission Control).
set -euo pipefail

REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
HYPR="$REPO/profiles/hypr/.config"
APP="${SKYLAND_APP:-$REPO/.build/Skyland.app}"
STATE="$HOME/.config/.skyland-profile" # read by the sketchybarrc hook (profiles/hypr/sketchybar/skyland.sh)

case "${1:-hypr}" in
    hypr) ;;
    status) echo hypr; exit 0 ;;
    *) echo "usage: skyland-env [hypr] | status" >&2; exit 1 ;;
esac

for entry in "$HYPR"/* "$HYPR"/.[!.]*; do
    [[ -e "$entry" ]] || continue
    dest="$HOME/.config/$(basename "$entry")"
    if [[ -e "$dest" && ! -L "$dest" ]]; then
        echo "skip $dest: real file, move it away first" >&2
        continue
    fi
    ln -sfn "$entry" "$dest"
done

echo hypr > "$STATE"
open "$APP"
sketchybar --reload 2>/dev/null || true
# ponytail: --reload runs sketchybarrc asynchronously, give it time before
# replacing its Spaces by skyland workspaces (the rc hook does it too)
{ sleep 1.5; "$REPO/profiles/hypr/sketchybar/skyland.sh"; } >/dev/null 2>&1 &
echo "profile: hypr"

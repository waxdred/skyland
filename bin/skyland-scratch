#!/usr/bin/env bash
# Hyprland-like scratchpads (togglespecialworkspace), kept for existing bindings: the
# `scratchpad` command does it inside skyland (no process per toggle, slide animation).
# usage: skyland-scratch toggle [name] [--app <bundle id>] | move [name]
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
exec "$REPO/.build/skyland-cli" scratchpad "$@" </dev/null

#!/usr/bin/env bash
# Hyprland-like scratchpads (togglespecialworkspace): windows parked on a hidden
# workspace pop up floating over the focused workspace, and go back.
# usage: skyland-scratch toggle [name] [--app <bundle id>] | move [name]
#   toggle  scratchpad windows shown here: hide them; else bring them here, floating.
#           --app: when the scratchpad is empty, take that app's window (and start
#           the app if needed), like Hyprland special:music with a Spotify rule
#   move    send the focused window to the scratchpad (hides it)
# The default scratchpad lives on workspace "scratch", a named one on "scratch-<name>".
# A shown scratchpad window made tiling (alt-space) leaves its scratchpad.
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
A() { "$REPO/.build/aerospace" "$@" </dev/null; }

action="${1:-toggle}"; shift || true
name="" app=""
while (($#)); do
    case "$1" in
        --app) app="${2:-}"; shift 2 ;;
        *) name="$1"; shift ;;
    esac
done
[[ "$name" =~ ^[A-Za-z0-9_-]*$ ]] || { echo "skyland-scratch: bad name '$name'" >&2; exit 1; }
workspace="scratch${name:+-$name}"
SHOWN="$HOME/.cache/skyland/scratch-shown${name:+-$name}" # ids of its windows out on a workspace
mkdir -p "$(dirname "$SHOWN")"
touch "$SHOWN"

# keep only shown windows that still exist and float (tiled = taken out of the scratchpad)
alive="$(A list-windows --all --format '%{window-id} %{window-layout}' | awk '$2 == "floating" { print $1 }')"
grep -Fxf <(echo "$alive") "$SHOWN" > "$SHOWN.tmp" || true
mv "$SHOWN.tmp" "$SHOWN"

case "$action" in
    toggle)
        here="$(A list-windows --workspace focused --format '%{window-id}')"
        if [[ -s "$SHOWN" ]] && grep -Fxqf "$SHOWN" <(echo "$here"); then
            while read -r id; do A move-node-to-workspace --window-id "$id" "$workspace"; done < "$SHOWN"
            : > "$SHOWN"
            exit 0
        fi
        target="$(A list-workspaces --focused)"
        ids="$( { cat "$SHOWN"; A list-windows --workspace "$workspace" --format '%{window-id}' 2>/dev/null || true; } | sort -u | grep . || true)"
        if [[ -z "$ids" && -n "$app" ]]; then
            ids="$(A list-windows --monitor all --app-bundle-id "$app" --format '%{window-id}' | head -1)"
            if [[ -z "$ids" ]]; then # start it and wait for its first window
                open -b "$app"
                for _ in $(seq 1 40); do
                    sleep 0.25
                    ids="$(A list-windows --monitor all --app-bundle-id "$app" --format '%{window-id}' | head -1)"
                    [[ -n "$ids" ]] && break
                done
            fi
        fi
        [[ -n "$ids" ]] || exit 0
        while read -r id; do
            A move-node-to-workspace --window-id "$id" "$target"
            A layout --window-id "$id" floating || true # already floating: fine
        done <<<"$ids"
        echo "$ids" > "$SHOWN"
        A focus --window-id "$(head -1 <<<"$ids")"
        ;;
    move)
        id="$(A list-windows --focused --format '%{window-id}')"
        A move-node-to-workspace --window-id "$id" "$workspace"
        grep -vFx "$id" "$SHOWN" > "$SHOWN.tmp" || true
        mv "$SHOWN.tmp" "$SHOWN"
        ;;
    *) echo "usage: skyland-scratch toggle [name] [--app <bundle id>] | move [name]" >&2; exit 1 ;;
esac

#!/usr/bin/env bash
# New terminal window (alt-t). [terminal] app in the config, Ghostty by default.
# A new window of the running terminal rather than a new instance of the app,
# so closed windows don't leave one copy per window in the Dock.
#   Ghostty, iTerm: AppleScript (Ghostty 1.3+); WezTerm: wezterm cli; kitty: its
#   --single-instance; anything else: open -na <app>.
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
app="$("$REPO/bin/skyland-config" terminal app)"
app="${app:-Ghostty}"
running() { pgrep -xiq "$1"; }
case "$(tr '[:upper:]' '[:lower:]' <<<"$app")" in
    ghostty)
        if running ghostty; then osascript -e 'tell application "Ghostty" to new window' >/dev/null; else open -a Ghostty; fi ;;
    iterm | iterm2)
        if running iTerm2; then osascript -e 'tell application "iTerm" to create window with default profile' >/dev/null; else open -a iTerm; fi ;;
    wezterm)
        if running wezterm-gui; then /Applications/WezTerm.app/Contents/MacOS/wezterm cli spawn --new-window >/dev/null; else open -a WezTerm; fi ;;
    kitty)
        /Applications/kitty.app/Contents/MacOS/kitty --single-instance --detach >/dev/null 2>&1 || open -na kitty ;;
    *)
        open -na "$app" ;;
esac

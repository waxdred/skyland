#!/usr/bin/env bash
# Install skyland from this checkout: dependencies (Brewfile), Swift toolchain,
# signing identity, build, the `skyland` CLI in ~/.local/bin, config links, start.
# From a release zip (.build/PREBUILT): no Swift and no build, the downloaded
# binaries are taken out of quarantine and signed with the local identity.
# Safe to run again (each step skips what is already there).
# usage: skyland install   (or bin/skyland-install)
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$REPO"
# Homebrew: link through opt/skyland, which follows upgrades (Cellar/<version> goes away)
[[ "$REPO" =~ ^(.*)/Cellar/skyland/[^/]+/libexec$ ]] && REPO="${BASH_REMATCH[1]}/opt/skyland/libexec"
step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*"; }
prebuilt="$( [[ -f .build/PREBUILT ]] && cat .build/PREBUILT || true )"

[[ "$(uname -m)" == arm64 ]] || warn "built and tested on Apple Silicon only"
command -v brew >/dev/null || { echo "Homebrew is required: https://brew.sh" >&2; exit 1; }

step "Dependencies (Brewfile)"
# recent Homebrew refuses third-party taps until trusted: felixkratz/formulae is
# the sketchybar / borders tap (https://github.com/FelixKratz/homebrew-formulae)
if brew trust --help >/dev/null 2>&1; then
    echo "trusting the felixkratz/formulae tap (sketchybar, borders)"
    brew tap felixkratz/formulae >/dev/null && brew trust felixkratz/formulae
fi
# --no-upgrade: install what is missing, never update what you already have
if [[ -n "$prebuilt" ]]; then
    grep -v '"swiftly"' "$REPO/Brewfile" | brew bundle --no-upgrade --file=- # a release needs no Swift toolchain
else
    brew bundle --no-upgrade --file "$REPO/Brewfile"
fi
if ! command -v matugen >/dev/null && [[ ! -x "$HOME/.cargo/bin/matugen" ]]; then
    if command -v cargo >/dev/null; then cargo install matugen; else warn "no cargo: skipping matugen (colors from the wallpaper). Install Rust, then: cargo install matugen"; fi
fi

if [[ -z "$prebuilt" ]]; then
    step "Swift $(cat .swift-version) (swiftly)"
    [[ -d "$HOME/.swiftly" ]] || swiftly init --assume-yes --skip-install --quiet-shell-followup
    # shellcheck source=/dev/null
    [[ -r "$HOME/.swiftly/env.sh" ]] && source "$HOME/.swiftly/env.sh"
    swiftly install "$(cat .swift-version)"
fi

step "Signing identity (keeps the Accessibility permission across rebuilds)"
security find-identity -v -p codesigning | grep -q '"skyland-codesign"' || bin/skyland-cert

if [[ -n "$prebuilt" ]]; then
    step "Release $prebuilt: prebuilt binaries"
    xattr -dr com.apple.quarantine "$REPO" 2>/dev/null || true # downloaded zip: Gatekeeper
    codesign --force --sign skyland-codesign --entitlements resources/AeroSpace.entitlements .build/Skyland.app
else
    step "Build"
    git submodule update --init --recursive
    bin/skyland-build
fi

step "skyland CLI in ~/.local/bin"
mkdir -p "$HOME/.local/bin"
ln -sfn "$REPO/bin/skyland" "$HOME/.local/bin/skyland"
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || warn "add ~/.local/bin to your PATH (fish: fish_add_path ~/.local/bin, zsh: export PATH=\$HOME/.local/bin:\$PATH)"

step "Config and start"
brew services start sketchybar >/dev/null 2>&1 || true
bin/skyland-env

cat <<MSG

Done. Run  skyland doctor  to check everything. Next:
  1. System Settings > Privacy & Security > Accessibility: allow Skyland
     (Screen Recording too, for the overview thumbnails and the media widget bars).
  2. Hook sketchybar: end your sketchybarrc with
       [ -x "\$HOME/.local/bin/skyland" ] && "\$HOME/.local/bin/skyland" bar >/dev/null 2>&1 &
  3. Shortcuts: alt-shift-h. Settings: alt-i. Config: ~/.config/skyland/skyland.toml
  4. Optional, window effects (corners, opacity, animations, floating on top):
     partial SIP disable + boot-arg, then skyland sa build && skyland sa load. See README.
MSG

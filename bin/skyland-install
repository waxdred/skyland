#!/usr/bin/env bash
# Install skyland from this checkout: dependencies (Brewfile), Swift toolchain,
# signing identity, build, the `skyland` CLI in ~/.local/bin, config links, start.
# Safe to run again (each step skips what is already there).
# usage: skyland install   (or bin/skyland-install)
set -euo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
cd "$REPO"
step() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m!! %s\033[0m\n' "$*"; }

[[ "$(uname -m)" == arm64 ]] || warn "built and tested on Apple Silicon only"
command -v brew >/dev/null || { echo "Homebrew is required: https://brew.sh" >&2; exit 1; }

step "Dependencies (Brewfile)"
brew bundle --file "$REPO/Brewfile"
if ! command -v matugen >/dev/null && [[ ! -x "$HOME/.cargo/bin/matugen" ]]; then
    if command -v cargo >/dev/null; then cargo install matugen; else warn "no cargo: skipping matugen (colors from the wallpaper). Install Rust, then: cargo install matugen"; fi
fi

step "Swift $(cat .swift-version) (swiftly)"
[[ -d "$HOME/.swiftly" ]] || swiftly init --assume-yes --skip-install
# shellcheck source=/dev/null
[[ -r "$HOME/.swiftly/env.sh" ]] && source "$HOME/.swiftly/env.sh"
swiftly install "$(cat .swift-version)"

step "Signing identity (keeps the Accessibility permission across rebuilds)"
security find-identity -v -p codesigning | grep -q '"skyland-codesign"' || bin/skyland-cert

step "Build"
git submodule update --init --recursive
bin/skyland-build

step "skyland CLI in ~/.local/bin"
mkdir -p "$HOME/.local/bin"
ln -sfn "$REPO/bin/skyland" "$HOME/.local/bin/skyland"
[[ ":$PATH:" == *":$HOME/.local/bin:"* ]] || warn "add ~/.local/bin to your PATH (fish: fish_add_path ~/.local/bin, zsh: export PATH=\$HOME/.local/bin:\$PATH)"

step "Config and start"
brew services start sketchybar >/dev/null 2>&1 || true
bin/skyland-env

cat <<MSG

Done. Next:
  1. System Settings > Privacy & Security > Accessibility: allow Skyland
     (Screen Recording too, for the overview thumbnails and the media widget bars).
  2. Hook sketchybar: end your sketchybarrc with  command -v skyland >/dev/null && skyland bar &
  3. Shortcuts: alt-shift-h. Settings: alt-i. Config: ~/.config/aerospace/aerospace.toml
  4. Optional, window effects (corners, opacity, animations, floating on top):
     partial SIP disable + boot-arg, then skyland sa build && skyland sa load. See README.
MSG

#!/usr/bin/env bash
# Build, install and inject the skyland scripting addition into Dock.
# usage: skyland-sa build | load | send <command...>
#   build  compile payload + loader into .build/osax
#   load   (sudo) install into /Library/ScriptingAdditions/skyland.osax, inject into Dock
#   send   send one command to the payload, e.g. `skyland-sa send corner 414 12`
# Requires SIP partially disabled and boot-arg -arm64e_preview_abi (same as yabai).
set -euo pipefail
cd "$(dirname "$(readlink -f "$0")")/.."

OUT=.build/osax
# Dock can only load code from /Library/ScriptingAdditions (it ignored the
# payload from /Library/Application Support). A real osax bundle with an
# OSAXHandlers Info.plist keeps osascript from warning. Must match payload_path
# in osax/loader.m.
DEST=/Library/ScriptingAdditions/skyland.osax

case "${1:-}" in
    build)
        mkdir -p "$OUT"
        # unlink first: a build once run with sudo leaves root-owned files that
        # the linker cannot overwrite (the directory is ours, so rm works)
        rm -f "$OUT/payload" "$OUT/loader" "$OUT/bezier_test" "$OUT/payload_test"
        # Xcode 26 ld emits arm64e ABI v1 (USR01) by default; Dock on macOS 15 is
        # v0 (USR00) and the kernel refuses cross-ABI thread injection, so force v0.
        abi=-Wl,-no_mac_public_arm64e
        xcrun clang osax/payload.m -shared -fPIC -O2 -arch arm64e -mmacosx-version-min=13.0 $abi \
            -F/System/Library/PrivateFrameworks -framework SkyLight -framework CoreGraphics -framework CoreFoundation -framework CoreVideo \
            -o "$OUT/payload"
        xcrun clang osax/loader.m -O2 -arch arm64e -mmacosx-version-min=13.0 -framework Cocoa $abi -o "$OUT/loader"
        xcrun clang osax/bezier_test.c -o "$OUT/bezier_test" && "$OUT/bezier_test"
        # the animation table and `track`, without SkyLight (stand-in headers, fake clock)
        if xcrun clang -fblocks -w -I osax/test/stubs osax/test/payload_test.c -o "$OUT/payload_test"; then
            "$OUT/payload_test"
        else
            echo "payload_test not built (osax/test/payload_test.c), the payload itself is" >&2
        fi
        otool -hv "$OUT/payload" "$OUT/loader" | awk '/ARM64/ {print "abi:", $4}'
        echo "built $OUT/payload $OUT/loader"
        ;;
    load)
        [[ $EUID -eq 0 ]] || exec sudo "$0" load
        rm -rf "/Library/Application Support/skyland" "$DEST" # old layouts
        mkdir -p "$DEST/Contents/MacOS" "$DEST/Contents/Resources"
        cp "$OUT/loader" "$DEST/Contents/MacOS/"
        cp "$OUT/payload" "$DEST/Contents/Resources/"
        cat > "$DEST/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key><string>com.waxdred.skyland-osax</string>
    <key>CFBundleExecutable</key><string>loader</string>
    <key>CFBundlePackageType</key><string>osax</string>
    <key>OSAXHandlers</key><dict/>
</dict>
</plist>
PLIST
        "$DEST/Contents/MacOS/loader" "$(pgrep -x -u "$(stat -f %Su /dev/console)" Dock)"
        echo "injected into Dock"
        # sudoers rule pinned to the loader sha256, so the login LaunchAgent can
        # inject without a password. A rebuild changes the hash: an existing rule
        # is renewed, a new one is only written when you say yes.
        SUDOERS=/private/etc/sudoers.d/skyland
        if [[ -f "$SUDOERS" ]] || { [[ -t 0 ]] &&
            read -rp "Inject at login without a password (sudoers rule for this loader only)? [y/N] " answer &&
            [[ "$answer" == [yY]* ]]; }; then
            hash="$(shasum -a 256 "$DEST/Contents/MacOS/loader" | cut -d' ' -f1)"
            tmp="$(mktemp)"
            echo "${SUDO_USER:-$(stat -f %Su /dev/console)} ALL=(root) NOPASSWD: sha256:$hash $DEST/Contents/MacOS/loader" > "$tmp"
            visudo -cqf "$tmp" && install -m 0440 -o root -g wheel "$tmp" "$SUDOERS" && echo "sudoers rule: $SUDOERS"
            rm -f "$tmp"
        fi
        ;;
    send)
        shift
        echo "$*" | nc -U "/tmp/skyland-sa_$USER.socket"
        ;;
    *)
        echo "usage: skyland-sa build | load | send <command...>" >&2
        exit 1
        ;;
esac

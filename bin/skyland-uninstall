#!/usr/bin/env bash
# Remove skyland from this Mac: quit it, the `skyland` CLI link, the ~/.config links
# into this repo, the login LaunchAgent, the lock screen saver, the scripting
# addition and its sudoers rule (sudo), caches. The repo itself stays: delete it by hand.
# Asks before starting. Your own files (sketchybarrc, configs that are real files)
# are never touched.
# usage: skyland uninstall
set -uo pipefail
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
step() { printf '\033[1;36m==> %s\033[0m\n' "$*"; }

cat <<EOF
This removes skyland from this Mac:
  - quits Skyland.app, removes ~/.local/bin/skyland
  - removes the ~/.config links that point into $REPO
  - unloads and deletes ~/Library/LaunchAgents/com.waxdred.skyland.plist
  - uninstalls the lock screen saver
  - with sudo: /Library/ScriptingAdditions/skyland.osax, /private/etc/sudoers.d/skyland
  - deletes ~/.cache/skyland
EOF
read -r -p "Continue? [y/N] " answer
[[ "$answer" == [yY]* ]] || { echo "Nothing removed."; exit 0; }

step "Quit Skyland"
"$REPO/.build/debug/aerospace" enable off </dev/null >/dev/null 2>&1 # windows back from their hiding corner
pkill -x AeroSpaceApp 2>/dev/null
pkill -x borders 2>/dev/null

step "CLI and config links"
[[ "$(readlink ~/.local/bin/skyland 2>/dev/null)" == "$REPO"/* ]] && rm ~/.local/bin/skyland
for link in ~/.config/*; do
    [[ -L "$link" && "$(readlink "$link")" == "$REPO"/* ]] && rm "$link" && echo "removed $link"
done
rm -f ~/.config/.skyland-profile

step "Login LaunchAgent"
launchctl bootout "gui/$(id -u)/com.waxdred.skyland" 2>/dev/null
rm -f ~/Library/LaunchAgents/com.waxdred.skyland.plist ~/Library/LaunchAgents/com.waxdred.skyland.start-at-login.plist

step "Lock screen saver"
"$REPO/bin/skyland-lock" uninstall 2>/dev/null || true

step "Scripting addition and sudoers rule (sudo)"
if [[ -e /Library/ScriptingAdditions/skyland.osax || -e /private/etc/sudoers.d/skyland ]]; then
    sudo rm -rf /Library/ScriptingAdditions/skyland.osax /private/etc/sudoers.d/skyland && killall Dock # Dock forgets the payload
fi

step "Caches"
rm -rf ~/.cache/skyland /tmp/skyland-sa_"$(whoami)".socket

echo
echo "Done. Left in place: the repo ($REPO), Homebrew packages (Brewfile), your sketchybarrc"
echo "(remove its 'skyland bar' line), the Accessibility / Screen Recording entries of Skyland."
